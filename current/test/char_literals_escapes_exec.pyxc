# RUN: %pyxc --emit exe -o %t %s
# RUN: %t 2>&1 | FileCheck %s
# CHECK: 1.000000
# CHECK: 1.000000
# CHECK: 1.000000

# Tests: backslash and single-quote escapes, plus null byte.

extern def printd(x: float64)

def main() -> int:
  if '\\' == 92:
    printd(1.0)
  else:
    printd(0.0)

  if '\'' == 39:
    printd(1.0)
  else:
    printd(0.0)

  if '\0' == 0:
    printd(1.0)
  else:
    printd(0.0)

  return 0
