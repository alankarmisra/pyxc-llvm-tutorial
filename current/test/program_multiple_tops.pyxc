# RUN: %pyxc < %s 2>&1 | FileCheck %s
# CHECK: 2.000000


# Tests: a program with multiple top-level forms separated by blank lines.
# program = [ end-of-lines ] [ top { end-of-lines top } ] [ end-of-lines ]
# top     = definition | external | top-level-expression

extern def printd(x: float64) -> float64

def double_it(x: float64) -> float64: return x + x

double_it(1)
