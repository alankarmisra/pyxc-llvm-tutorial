# RUN: %pyxc < %s 2>&1 | FileCheck %s
# CHECK: Unary operator must have exactly one argument


# Tests: a unary operator function signature with two arguments is rejected.
# unaryopprototype = customopchar "(" name ")"
# ParseUnaryOpPrototype checks ParameterNames.size() != 1.

@unary
def %(x: float64, y: float64) -> float64: return x
