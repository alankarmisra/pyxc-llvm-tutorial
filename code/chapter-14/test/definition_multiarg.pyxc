# RUN: %pyxc < %s 2>&1 | FileCheck %s
# CHECK: 7.000000


# Tests: definition with a multi-argument function signature and a matching callexpr.
# function signature  = identifier "(" identifier { "," identifier } ")"
# callexpr   = identifier "(" expression { "," expression } ")"

def add3(a, b, c): return a + b + c

add3(1, 2, 4)
