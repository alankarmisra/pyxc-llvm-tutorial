# RUN: %pyxc < %s 2>&1 | FileCheck %s
# CHECK: 1.000000

def count_middle() -> float64:
  var i: float64 = 0
  var sum: float64 = 0
  while i < 3:
    i = i + 1
    if i == 1:
      continue
      sum = sum + 100  # unreachable
    if i == 3:
      break
      sum = sum + 100  # unreachable
    sum = sum + 1
  return sum

count_middle()
