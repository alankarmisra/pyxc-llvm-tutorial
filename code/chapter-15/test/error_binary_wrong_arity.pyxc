# RUN: %pyxc < %s 2>&1 | FileCheck %s
# CHECK: Binary operator must have exactly two arguments


# Tests: a binary operator function signature with only one argument is rejected.
# binaryopprototype = customopchar "(" name "," name ")"
# ParseBinaryOperatorSignature checks ParameterNames.size() != 2.

@binary(5)
def %(x): return x
