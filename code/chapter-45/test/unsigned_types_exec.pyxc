# RUN: %pyxc --emit exe -o %t %s
# RUN: %t 2>&1 | FileCheck %s
# CHECK: 255.000000
# CHECK: 65535.000000
# CHECK: 4294967296.000000

# Tests: uint8, uint16, and uint64 all parse and compute correctly.
# uint8(-1)  = 255  (wraps at 8 bits)
# uint16(-1) = 65535 (wraps at 16 bits)
# uint64: add across the uint32 boundary to confirm 64-bit range.
# 2^32 = 4294967296, which is exactly representable in float64.

extern def printd(x: float64)

def main() -> int:
  var a: uint8  = uint8(-1)              # 255
  var b: uint16 = uint16(-1)             # 65535
  var c: uint64 = uint64(4294967295) + uint64(1)  # 2^32

  printd(float64(a))
  printd(float64(b))
  printd(float64(c))

  return 0
