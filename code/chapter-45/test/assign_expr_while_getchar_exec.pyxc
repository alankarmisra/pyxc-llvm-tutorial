# RUN: %pyxc --emit exe -o %t %s
# RUN: printf "a b c\n" | %t 2>&1 | FileCheck %s
# CHECK: 2.000000

extern def getchar() -> int32
extern def printd(x: float64)

var EOF: int32 = -1

def main() -> int:
  var c: int32
  var blanks: int
  while (c = getchar()) != EOF:
    if c == ' ':
      blanks = blanks + 1
  printd(float64(blanks))
  return 0
