# RUN: %pyxc --emit exe -o %t %s
# RUN: %t 2>&1 | FileCheck %s
# CHECK: 1.000000
# CHECK: 0.000000

# Tests: unsigned comparison uses icmp ugt, not icmp sgt.
# uint32(-1) is 4294967295, which is greater than 0 in unsigned order.
# int32(-1) is -1, which is less than 0 in signed order — so the comparison
# must be dispatched as unsigned to produce the correct result.

extern def printd(x: float64)

def main() -> int:
  var a: uint32 = uint32(-1)   # 4294967295
  var b: uint32 = 0
  if a > b:
    printd(1.0)
  else:
    printd(0.0)

  var c: int32 = -1
  if c > int32(0):
    printd(1.0)
  else:
    printd(0.0)

  return 0
