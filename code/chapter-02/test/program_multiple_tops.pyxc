# CHECK-DAG: {{Parsed a function definition.}}
# CHECK-DAG: {{Parsed a function definition.}}
# CHECK-DAG: {{Parsed a top-level expression.}}
# CHECK-NOT: {{Parsed a function definition.}}

# program: multiple top-level items separated by single and multiple blank lines
# also exercises end-of-lines = end-of-line { end-of-line }
def foo(x):
  x + 1


def bar(x, y):
  x + y

1 + 2
