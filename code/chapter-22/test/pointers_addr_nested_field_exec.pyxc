# RUN: %pyxc --emit exe -o %t %s
# RUN: %t 2>&1 | FileCheck %s
# CHECK: 23.000000

extern def printd(x: float64)

struct Inner:
  value: int

struct Outer:
  inner: Inner

def main() -> int:
  var o: Outer
  o.inner.value = 23
  var p: ptr[int] = addr(o.inner.value)
  printd(float64(p[0]))
  return 0
