import include

def abs(x:int) -> int:
    if x < 0:
        return -x 
    else:
        return x

def itoa(n: int, s: string):
    printf("n")

def reverse_in_place(s: string):
    var i:int = 0
    var j:int = strlen(s) - 1
    while i < j:
        var t:int8 = s[i]
        s[i] = s[j]
        s[j] = t
        i += 1
        j -= 1

def copy_cstr(src: string) -> string:
  var n: int64 = strlen(src)
  var dst: string = ptr[int8](malloc(n + 1))
  var i: int64 = 0
  while i < n:
    dst[i] = src[i]
    i += 1
  dst[n] = int8(0)
  return dst

def main() -> int:
  var s: string = copy_cstr("hello, world")
  reverse_in_place(s)
  printf("%s\n", s)
  free(s)
  return 0
