
export type string = ptr[int8]

export extern def printf(fmt: string, ...) -> int32
export extern def puts(s: ptr[int8]) -> int32
export extern def getchar() -> int32
export extern def putchar(c: int32) -> int32
export extern def scanf(fmt: ptr[int8], ...) -> int32
export extern def strlen(s: ptr[int8]) -> int64
export extern def malloc(size: int64) -> ptr[int8]
export extern def free(p: ptr[int8])
