type string = ptr[int8]
extern def getchar() -> int32
extern def printf(fmt: string, ...) -> int

var EOF: int32 = -1
var SPACE: int32 = 32
var NEWLINE: int32 = 10
var TAB: int32 = 9

def main() -> int:
    var c:int32, nb:int, nt:int, nl:int # default initialized to 0
    c = getchar()
    while c != EOF:
        if c == SPACE:
            ++nb
        if c == TAB:
            ++nt
        if c == NEWLINE:
            ++nl
        c = getchar()

    printf("spaces = %d, tabs = %d, newlines = %d\n", nb, nt, nl)    
    return 0
        