# RUN: %pyxc --emit exe -o %t %s
# RUN: %t 2>&1 | FileCheck %s
# CHECK: 1.000000

extern def printd(x: float64)

struct Pair:
  a: int
  b: int

def main() -> int:
  var p: Pair
  var start: ptr[int] = addr(p.a)
  var next: ptr[int] = start + 1
  if start != next:
    printd(1.0)
  else:
    printd(0.0)
  return 0
