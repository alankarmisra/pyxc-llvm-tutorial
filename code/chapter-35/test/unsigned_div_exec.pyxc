# RUN: %pyxc --emit exe -o %t %s
# RUN: %t 2>&1 | FileCheck %s
# CHECK: 2147483647.000000
# CHECK: 1.000000

# Tests: unsigned division (udiv) and modulo (urem).
# uint32(-1) = 4294967295; 4294967295 / 2 = 2147483647 with udiv.
# int32(-1) / 2 = -1 (sdiv rounds toward zero), so the signed path
# would give a very different answer.

extern def printd(x: float64)

def main() -> int:
  var x: uint32 = uint32(-1)   # 4294967295
  printd(float64(x / uint32(2)))

  # urem: 7 % 3 = 1
  var a: uint32 = 7
  var b: uint32 = 3
  printd(float64(a % b))

  return 0
