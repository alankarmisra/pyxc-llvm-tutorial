# RUN: %pyxc --emit exe -o %t %s
# RUN: %t 2>&1 | FileCheck %s
# CHECK: 1.000000

extern def printd(x: float64)

struct Pair:
  a: int
  b: int

def main() -> int:
  var t: Pair
  var p: ptr[int] = addr(t.a)
  var q: ptr[int] = addr(t.b)
  if q > p:
    printd(1.0)
  else:
    printd(0.0)
  return 0
