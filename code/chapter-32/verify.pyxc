extern def printd(x: float64)
def main() -> int:
  var a: int = 17
  var b: int = 4
  var q: int = a / b
  var r: int = a % b
  printd(float64(q))
  printd(float64(r))

  var x: int = 10
  x += 5
  x -= 3
  x *= 2
  x /= 4
  x %= 10
  printd(float64(x))

  var i: int = 0
  i++
  ++i
  printd(float64(i))
  return 0
