# RUN: %pyxc --emit exe -o %t %s
# RUN: %t 2>&1 | FileCheck %s
# CHECK: 5.000000

extern def printd(x: float64)

class Point:
  x: int
  y: int

  def __init__(x: int, y: int) -> None:
    self.x = x
    self.y = y

def main() -> int:
  var p: Point = Point(2, 3)
  printd(float64(p.x + p.y))
  return 0
