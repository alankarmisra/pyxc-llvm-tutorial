# RUN: not %pyxc --emit llvm-ir -o %t.ll %s 2>&1 | FileCheck %s
# CHECK: {{[Ee]rror}}
# CHECK: Incorrect number of arguments in construction of 'Point': expected 2, got 1

class Point:
  x: int
  y: int

  def __init__(x: int, y: int) -> None:
    self.x = x
    self.y = y

def main() -> int:
  var p: Point = Point(1)
  return 0
