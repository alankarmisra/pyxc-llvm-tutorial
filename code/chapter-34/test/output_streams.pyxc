# RUN: %pyxc < %s > %t.stdout 2> %t.stderr
# RUN: grep -Fxq "A0.000000" %t.stdout
# RUN: grep -Fxq "7.000000" %t.stdout
# RUN: grep -Fxq "42.000000" %t.stdout
# RUN: not grep -q "ready>" %t.stdout
# RUN: not grep -Eq "^(0|7|42)\\.000000$" %t.stderr
# RUN: grep -q "ready>" %t.stderr

# Successful REPL and program output goes to stdout. Prompts and diagnostics
# remain on stderr.
extern def putchard(x: float64) -> float64
extern def printd(x: float64) -> float64
putchard(65.0)
printd(7.0)
42.0
