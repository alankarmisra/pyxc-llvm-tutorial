# RUN: printf '$\n' | %pyxc 2>&1 | FileCheck %s --check-prefix=LEXER
# RUN: printf '# comment' | %pyxc 2>&1 | FileCheck %s --check-prefix=COMMENT --implicit-check-not=Error
# RUN: printf '(+)\n' | %pyxc 2>&1 | FileCheck %s --check-prefix=PAREN
# RUN: printf 'foo(+)\n' | %pyxc 2>&1 | FileCheck %s --check-prefix=CALL
# RUN: printf 'def bad(,): 1\n' | %pyxc 2>&1 | FileCheck %s --check-prefix=SIGNATURE
# RUN: printf 'def bad(): +\n' | %pyxc 2>&1 | FileCheck %s --check-prefix=BODY
# RUN: printf '1 * +\n' | %pyxc 2>&1 | FileCheck %s --check-prefix=TERM_RHS
# RUN: printf '1 < +\n' | %pyxc 2>&1 | FileCheck %s --check-prefix=COMPARISON_RHS
# RUN: printf -- '-+\n' | %pyxc 2>&1 | FileCheck %s --check-prefix=UNARY_MINUS_RHS

# LEXER: invalid character
# COMMENT: ready>
# PAREN: Unexpected '+'
# CALL: Unexpected '+'
# SIGNATURE: Expected ')' in function signature
# BODY: Unexpected '+'
# TERM_RHS: Unexpected '+'
# COMPARISON_RHS: Unexpected '+'
# UNARY_MINUS_RHS: Unexpected '+'

# coverage error paths: exercise lexer errors, comments ending at EOF, failed
# expressions inside parentheses and calls, malformed empty parameter lists,
# failed function bodies, a failed right operand for '*'/'/'/'%' (ParseTerm)
# and '<' (ParseComparison) — the same missing-right-operand shape
# recovery_after_error.pyxc already covers for '+'/'-' (ParseSum) but not
# for the other two binary-operator tiers — and a failed operand for unary
# '-' (ParseUnaryMinus).
