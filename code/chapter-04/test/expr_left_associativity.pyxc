# RUN: %pyxc < %s 2>&1 | FileCheck %s --check-prefix=CHECK --implicit-check-not="{{Error:}}"
# CHECK-DAG: {{Parsed a top-level expression.}}
# CHECK-DAG: {{Parsed a top-level expression.}}
# CHECK-NOT: {{Parsed a top-level expression.}}

# sum and term: operators in the same rule are left-associative
# a - b - c groups as (a-b)-c, not a-(b-c), because ParseSum merges each
# operator into Left before continuing its loop.
1 - 2 - 3
4 + 5 + 6
