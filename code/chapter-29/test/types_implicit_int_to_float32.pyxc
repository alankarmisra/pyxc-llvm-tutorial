# RUN: %pyxc --emit exe -o %t %s
# RUN: %t 2>&1 | FileCheck %s
# CHECK: 2.000000
# CHECK-NEXT: 2.500000
# CHECK-NEXT: 2.000000
# CHECK-NEXT: 2.000000

# Tests: integers can be implicitly converted to float32 in every context
# accepted by the type checker.

extern def printd(x: float64) -> float64

def return_float32(n: int32) -> float32:
    return n

def add_float32(a: int32, b: float32) -> float32:
    return a + b

def accept_float32(value: float32) -> float32:
    return value

def main() -> None:
    var n: int32 = 2
    var value: float32 = n
    printd(float64(value))
    printd(float64(add_float32(n, 0.5)))
    printd(float64(accept_float32(n)))
    printd(float64(return_float32(n)))
    return
