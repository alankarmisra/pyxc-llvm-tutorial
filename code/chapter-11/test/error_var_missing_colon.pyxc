# RUN: %pyxc < %s 2>&1 | FileCheck %s
# CHECK: Expected ':' after var bindings

# Tests: "var" without the mandatory ":" before the body is a parse error.
# ParseVariableExpression requires CurrentToken == ':' after all bindings are consumed.
# variable-expression = "var" variable-binding { "," variable-binding } ":" [ end-of-lines ] expression ;

var x = 1 x
