# RUN: %pyxc < %s 2>&1 | FileCheck %s
# CHECK: Evaluated to 0.000000

# Tests: var without an initializer defaults to 0.0.
# variable-binding = name [ "=" expression ] ;
#
# When no "=" follows the name, ParseVariableExpression inserts NumberExpressionNode(0.0)
# as the initializer. The body "x" loads that 0.0 slot.

var x: x
