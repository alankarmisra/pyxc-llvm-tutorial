# RUN: %pyxc < %s 2>&1 | FileCheck %s
# CHECK: Parsed an extern.
# CHECK: Parsed a function definition.
# CHECK: 0.000000
# CHECK: 1.000000
# CHECK: 2.000000
# CHECK: 3.000000
# CHECK: 4.000000
# CHECK: Evaluated to 5.000000

# The third field is the complete update expression. The loop executes the
# assignment once and does not add its result to i a second time.

extern def printd(x)

def side_step(): var i = 0: (for i = 0, i < 5, i = i + 1: printd(i)) + i

side_step()
