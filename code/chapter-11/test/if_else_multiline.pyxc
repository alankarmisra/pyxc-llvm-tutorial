# RUN: %pyxc < %s 2>&1 | FileCheck %s
# CHECK: Parsed a function definition.
# CHECK: Evaluated to 5.000000


# Tests: if/else with then and else expressions on separate lines.
# if-expression = "if" expression ":" [ end-of-lines ] expression [ end-of-lines ] "else" ":" [ end-of-lines ] expression
# The [ end-of-lines ] tokens before 'else' and after 'else:' allow this layout.

def minval(a, b):
if a < b:
a
else:
b

minval(5, 10)
