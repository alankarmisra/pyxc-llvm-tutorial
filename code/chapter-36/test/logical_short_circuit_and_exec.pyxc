# RUN: %pyxc --emit exe -o %t %s
# RUN: %t 2>&1 | FileCheck %s
# CHECK: 0.000000

extern def printd(x: float64)

var hits: int = 0

def touch() -> bool:
  hits = hits + 1
  return True

def main() -> int:
  var flag: bool = False
  if flag && touch():
    printd(999.0)
  printd(float64(hits))
  return 0
