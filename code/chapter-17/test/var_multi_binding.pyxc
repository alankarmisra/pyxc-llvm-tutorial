# RUN: %pyxc < %s 2>&1 | FileCheck %s
# CHECK: Parsed a function definition.
# CHECK: Evaluated to 3.000000

# Tests: var with multiple comma-separated bindings in one statement.
# variable-statement = "var" variable-binding { "," variable-binding } ;

def f():
    var x = 1, y = 2
    return x + y

f()
