# RUN: %pyxc %s 2>&1 | FileCheck %s
# CHECK: 1.000000
# CHECK: 2.000000
# CHECK-NOT: ready>

# Tests: for-statement nested inside if-statement block.
# compound-statement = if-statement | for-statement ;
# suite = simple-statement | compound-statement | end-of-lines block ;
# When n > 0, the if block runs the for loop. When n <= 0, nothing is printed.

extern def printd(x)

def run(n):
    if n > 0:
        for var i = 1, i <= n, 1:
            printd(i)

run(2)
run(0)
