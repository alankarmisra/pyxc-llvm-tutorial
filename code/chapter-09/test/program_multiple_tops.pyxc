# RUN: %pyxc < %s 2>&1 | FileCheck %s
# CHECK: Parsed an extern.
# CHECK: Parsed a function definition.
# CHECK: Evaluated to 2.000000


# Tests: a program with multiple top-level forms separated by blank lines.
# program = [ end-of-lines ]
#           [ top-level-item { end-of-lines top-level-item } ]
#           [ end-of-lines ]
# top-level-item = function-definition | external | top-level-expression

extern def printd(x)

def double(x): x + x

double(1)
