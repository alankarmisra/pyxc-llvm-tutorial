# RUN: %pyxc --emit llvm-ir -o %t.ll %s
# RUN: FileCheck --input-file=%t.ll %s
# CHECK: %struct.Pair = type { i{{32|64}}, i{{32|64}} }
# CHECK: getelementptr inbounds{{.*}} %struct.Pair, ptr %{{.*}}, i32 0, i32 0
# CHECK: getelementptr inbounds{{.*}} %struct.Pair, ptr %{{.*}}, i32 0, i32 1

struct Pair:
  a: int
  b: int

def first_plus_second(p: Pair) -> int:
  return p.a + p.b
