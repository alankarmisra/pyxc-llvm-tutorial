# RUN: %pyxc --emit exe -o %t %s
# RUN: %t 2>&1 | FileCheck %s
# CHECK: 2.000000

extern def printd(x: float64)

struct Triple:
  a: int
  b: int
  c: int

def main() -> int:
  var t: Triple
  var p: ptr[int] = addr(t.a)
  var q: ptr[int] = addr(t.c)
  var d: int64 = q - p
  printd(float64(d))
  return 0
