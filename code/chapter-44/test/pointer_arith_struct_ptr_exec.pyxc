# RUN: %pyxc --emit exe -o %t %s
# RUN: %t 2>&1 | FileCheck %s
# CHECK: 30.000000

extern def printd(x: float64)

# ptr[Point] + 1 must advance by sizeof(Point) bytes, not sizeof(int).
struct Point:
  x: int
  y: int

struct TwoPoints:
  first: Point
  second: Point

def main() -> int:
  var t: TwoPoints
  t.first.x = 10
  t.second.x = 30
  var p: ptr[Point] = addr(t.first)
  var q: ptr[Point] = p + 1
  printd(float64(q[0].x))
  return 0
