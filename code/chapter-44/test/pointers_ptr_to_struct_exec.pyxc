# RUN: %pyxc --emit exe -o %t %s
# RUN: %t 2>&1 | FileCheck %s
# CHECK: 7.000000

extern def printd(x: float64)

struct Point:
  x: int
  y: int

def set_x(p: ptr[Point], v: int) -> None:
  p[0].x = v

def main() -> int:
  var pt: Point
  pt.x = 3
  set_x(addr(pt), 7)
  printd(float64(pt.x))
  return 0
