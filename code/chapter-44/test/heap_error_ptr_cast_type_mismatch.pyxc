# RUN: not %pyxc --emit llvm-ir -o %t.ll %s 2>&1 | FileCheck %s
# CHECK: {{[Ee]rror}}
# CHECK: {{argument 1 expects ptr|type mismatch}}

extern def malloc(n: int64) -> ptr[int8]

def consume(p: ptr[float64]) -> int:
  return 0

def main() -> int:
  var raw: ptr[int8] = ptr[int8](malloc(8))
  var p: ptr[int] = ptr[int](raw)
  return consume(p)
