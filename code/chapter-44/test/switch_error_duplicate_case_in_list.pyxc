# RUN: not %pyxc --emit llvm-ir -o %t.ll %s 2>&1 | FileCheck %s
# CHECK: {{[Ee]rror}}
# CHECK: Duplicate switch case value

# Tests: a repeated value within a single comma-separated case list is
# still caught as a duplicate, same as a repeat across separate case lines.

def f(x: int) -> int:
  switch x:
    case 1, 2, 1:
      return 1
  return 0
