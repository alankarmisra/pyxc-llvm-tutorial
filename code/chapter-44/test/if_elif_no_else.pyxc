# RUN: %pyxc < %s 2>&1 | FileCheck %s
# CHECK: 1.000000
# CHECK: 2.000000
# CHECK: 0.000000

# Tests: if/elif chain with no else branch.
# When no branch matches, the whole statement is a no-op.

def classify(x: int) -> int:
    var result: int = 0
    if x == 1:
        result = 1
    elif x == 2:
        result = 2
    return result

float64(classify(1))
float64(classify(2))
float64(classify(99))
