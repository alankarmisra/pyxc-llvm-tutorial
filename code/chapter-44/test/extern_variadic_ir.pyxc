# RUN: %pyxc --emit llvm-ir -o %t.ll %s
# RUN: FileCheck %s < %t.ll
# CHECK: declare i64 @printf(ptr, ...)
# CHECK: call i64 (ptr, ...) @printf

type string = ptr[int8]
extern def printf(fmt: string, ...) -> int64

def main() -> int:
  printf("%ld\n", 42)  # %ld matches pyxc's int (64-bit); %d would be wrong
  return 0
