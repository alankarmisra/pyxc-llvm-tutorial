extern def printd(x: float64)
struct Point:
  x: int
  y: int

def translate(p: ptr[Point], dx: int, dy: int) -> None:
  p[0].x = p[0].x + dx
  p[0].y = p[0].y + dy

def main() -> int:
  var pt: Point
  pt.x = 3
  pt.y = 4
  translate(addr(pt), 10, 20)
  printd(float64(pt.x))
  printd(float64(pt.y))
  return 0
