# RUN: %pyxc --emit exe -o %t %s
# RUN: %t 2>&1 | FileCheck %s
# CHECK: 1.000000
# CHECK: 2.000000
# CHECK: 0.000000

extern def printd(x: float64)

# Tests: a case may list several comma-separated values that all share the
# same body. switchcase = "case" switchint { "," switchint } ":" suite ;

def classify(x: int) -> int:
  switch x:
    case 1, 3, 5, 7, 9:
      return 1
    case 2, 4, 6, 8:
      return 2
    default:
      return 0

def main() -> int:
  printd(float64(classify(3)))
  printd(float64(classify(4)))
  printd(float64(classify(10)))
  return 0
