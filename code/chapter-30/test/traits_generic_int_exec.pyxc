# RUN: %pyxc --emit exe -o %t %s
# RUN: %t 2>&1 | FileCheck %s
# CHECK: 7.000000

extern def printd(x: float64)

trait Addable[T]:
  def add(x: T, y: T) -> T

class IntCalc(Addable[int]):
  public def add(x: int, y: int) -> int:
    return x + y


def main() -> int:
  var c: IntCalc = IntCalc()
  printd(float64(c.add(3, 4)))
  return 0
