# RUN: %pyxc < %s 2>&1 | FileCheck %s --check-prefix=CHECK
# CHECK-DAG: {{Parsed a function definition}}
# CHECK-DAG: {{Parsed a function definition}}
# CHECK-NOT: {{Parsed a function definition}}

# FunctionDefinitionNode::codegen: NamedValues is cleared on each function entry.
# 'g' must not see 'a' from 'f'. If NamedValues were not cleared,
# 'g' returning 'a' would silently succeed; instead it must succeed
# only because 'g' has its own parameter also named 'a'.
def f(a): a
def g(a): a
