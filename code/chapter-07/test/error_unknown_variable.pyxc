# RUN: %pyxc < %s > %t 2>&1
# RUN: grep -q "Error" %t
# RUN: grep -q "Unknown variable name: z" %t

# NameExpressionNode::codegen error path: a name not in NamedValues triggers
# LogErrorValue. NamedValues only holds the current function's parameters, so
# 'z' is unknown even though 'x' and 'y' are valid.
def bad(x, y): z
