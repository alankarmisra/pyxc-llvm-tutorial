# RUN: %pyxc < %s 2>&1 | FileCheck %s --check-prefix=CHECK
# CHECK-DAG: {{Error}}
# CHECK-DAG: Incorrect number of arguments in call to 'pair': expected 2, got 1

# CallExpressionNode::codegen error path: arg_size() != Args.size() triggers LogErrorValue.
# 'pair' takes 2 arguments; calling it with 1 must fail at codegen time.
def pair(a, b): a + b
def bad(x): pair(x)
