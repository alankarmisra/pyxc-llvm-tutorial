# RUN: %pyxc < %s 2>&1 | FileCheck %s --check-prefix=CHECK
# CHECK-DAG: {{Error \(Line}}
# CHECK-DAG: {{Error \(Line}}
# CHECK-DAG: {{Error \(Line}}
# CHECK-NOT: {{Error \(Line}}

# Diagnostics: line numbers increment across successive inputs.
# Each bad 'def' is a separate line; exactly 3 errors must appear.
# The # RUN/comment lines above are fed to pyxc as Pyxc comments and shift
# the absolute line numbers — but there must be exactly 3 error lines total.
def 1
def 2
def 3
