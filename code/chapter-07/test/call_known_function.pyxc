# RUN: %pyxc < %s 2>&1 | FileCheck %s --check-prefix=CHECK
# CHECK-DAG: {{Parsed a function definition}}
# CHECK-DAG: {{call double @double_it}}

# CallExpressionNode::codegen: callee looked up by name in TheModule; emits a call
# instruction against it. Both the callee definition and the caller must appear.
def double_it(x): x + x
def caller(a): double_it(a)
