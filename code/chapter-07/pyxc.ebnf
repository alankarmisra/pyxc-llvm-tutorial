(*
   pyxc.ebnf
   Grammar for chapter 6 - JIT + REPL.
*)

(*
   { } = zero or more (any number of...)
   [ ] = zero or one (optional)
*)

program         = [ eols ] [ top { eols top } ] [ eols ] ;
eols            = eol { eol } ;
top             = functiondef | external | toplevelexpr ;
functiondef      = "def" functionsignature ":" [ eols ] expression ;
external        = "extern" "def" functionsignature ;
toplevelexpr    = expression ;
functionsignature       = name "(" [ name { "," name } ] ")" ;
expression      = primary binoprhs ;
binoprhs        = { binaryop primary } ;
primary         = nameexpr | numberexpr | parenexpr ;
nameexpr  = name | callexpr ;
callexpr        = name "(" [ expression { "," expression } ] ")" ;
numberexpr      = number ;
parenexpr       = "(" expression ")" ;
binaryop        = "+" | "-" | "*" ;
name      = (letter | "_") { letter | digit | "_" } ;
number          = digit { digit } [ "." { digit } ]
                | "." digit { digit } ;
letter          = "A".."Z" | "a".."z" ;
digit           = "0".."9" ;
eol             = "\r\n" | "\r" | "\n" ;
ws              = " " | "\t" ;
