# RUN: %pyxc --emit exe -o %t %s
# RUN: %t 2>&1 | FileCheck %s
# CHECK: 1.000000

extern def printd(x: float64)

def main() -> int:
  var i: int = 0
  var sum: int = 0
  while i < 3:
    i += 1
    if i == 1:
      continue
      sum += 100  # unreachable
    if i == 3:
      break
      sum += 100  # unreachable
    sum += 1
  printd(float64(sum))
  return 0
