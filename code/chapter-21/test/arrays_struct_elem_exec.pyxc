# RUN: %pyxc --emit exe -o %t %s
# RUN: %t 2>&1 | FileCheck %s
# CHECK: 10.000000
# CHECK: 20.000000

extern def printd(x: float64)

struct Point:
  x: int
  y: int

def main() -> int:
  var pts: Point[2]
  pts[0].x = 10
  pts[1].x = 20
  printd(float64(pts[0].x))
  printd(float64(pts[1].x))
  return 0
