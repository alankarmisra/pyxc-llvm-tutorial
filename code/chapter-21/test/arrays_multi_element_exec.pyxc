# RUN: %pyxc --emit exe -o %t %s
# RUN: %t 2>&1 | FileCheck %s
# CHECK: 1.000000
# CHECK: 2.000000
# CHECK: 3.000000

extern def printd(x: float64)

def main() -> int:
  var a: int[3]
  a[0] = 1
  a[1] = 2
  a[2] = 3
  printd(float64(a[0]))
  printd(float64(a[1]))
  printd(float64(a[2]))
  return 0
