# RUN: %pyxc < %s 2>&1 | FileCheck %s
# CHECK: Parsed a function definition.
# CHECK: Evaluated to 9.000000

# Tests: call-expression where an argument is itself a non-trivial expression.
# call-expression = name "(" expression { "," expression } ")"

def square(x): x * x

# Argument is (1 + 2) = 3; square(3) = 9.
square(1 + 2)
