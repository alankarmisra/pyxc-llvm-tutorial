# RUN: %pyxc < %s > %t.stdout 2> %t.stderr
# RUN: FileCheck %s --check-prefix=STDOUT --implicit-check-not="{{ready>}}" --implicit-check-not="{{Parsed}}" < %t.stdout
# RUN: FileCheck %s --check-prefix=STDERR --implicit-check-not="{{Evaluated to}}" < %t.stderr
# STDOUT-DAG: {{^}}AEvaluated to 0.000000{{$}}
# STDOUT-DAG: {{^}}7.000000{{$}}
# STDOUT-DAG: {{^}}Evaluated to 42.000000{{$}}
# STDERR-DAG: {{ready>}}
# STDERR-DAG: {{Parsed an extern}}

# Successful REPL and program output goes to stdout. Prompts, parse messages,
# and IR dumps remain on stderr.
extern def putchard(x)
extern def printd(x)
putchard(65)
printd(7)
42
