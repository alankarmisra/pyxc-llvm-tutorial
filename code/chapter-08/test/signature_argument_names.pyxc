# RUN: %pyxc < %s 2>&1 | FileCheck %s --check-prefix=CHECK
# CHECK-DAG: {{Parsed a function definition}}
# CHECK-DAG: {{double %a}}
# CHECK-DAG: {{double %b}}

# FunctionSignatureNode::codegen: Argument.setName() makes parameter names appear in the IR.
# Without setName the IR would show %0 and %1 instead of %a and %b.
def f(a, b): a + b
