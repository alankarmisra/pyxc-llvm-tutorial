# RUN: %pyxc < %s 2>&1 | FileCheck %s --check-prefix=CHECK
# CHECK-DAG: {{Parsed a function definition}}
# CHECK-DAG: {{fcmp olt}}
# CHECK-DAG: {{uitofp}}

# BinaryExpressionNode::codegen '<': two-step codegen — CreateFCmpOLT produces an i1,
# then CreateUIToFP widens it to double (false->0.0, true->1.0).
# Both instructions must appear in the IR.
def lt(a, b): a < b
