# RUN: %pyxc < %s 2>&1 | FileCheck %s --check-prefix=CHECK
# CHECK-DAG: {{Parsed an extern}}
# CHECK-DAG: {{Evaluated to 0.000000}}
# CHECK-DAG: {{^7.000000}}

# Runtime library: printd prints its argument to stdout as "%f\n" and returns
# 0.0. The '7.000000' line comes from printd's own fprintf; the 'Evaluated to
# 0.000000' line comes from the JIT calling the __anon_expr wrapper.
extern def printd(x)
printd(7)
