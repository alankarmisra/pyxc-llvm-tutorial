# RUN: %pyxc < %s 2>&1 | FileCheck %s --check-prefix=CHECK
# CHECK-DAG: {{Parsed an extern}}
# CHECK-DAG: {{Evaluated to 0.841}}

# JIT + extern: sin(1.0) ≈ 0.841471. Confirms the JIT resolves the extern
# 'sin' to the C library implementation and gets the right numeric result.
extern def sin(x)
sin(1.0)
