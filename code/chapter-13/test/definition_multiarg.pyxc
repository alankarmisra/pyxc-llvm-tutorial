# RUN: %pyxc < %s 2>&1 | FileCheck %s
# CHECK: Parsed a function definition.
# CHECK: Evaluated to 7.000000


# Tests: definition with a multi-argument function signature and a matching call-expression.
# function signature  = name "(" name { "," name } ")"
# call-expression   = name "(" expression { "," expression } ")"

def add3(a, b, c): return a + b + c

add3(1, 2, 4)
