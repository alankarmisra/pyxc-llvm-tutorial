# RUN: %pyxc < %s | FileCheck %s --match-full-lines

# CHECK: 'def'
# CHECK: name: print
# CHECK: number: 1
# CHECK: number: 2

# sample: the add.pyxc example from the doc, run end-to-end through the lexer.
# add.pyxc
def add(x, y): # define a function
    x + y # return the sum

print(add(1, 2)) # call the add function and print its value
