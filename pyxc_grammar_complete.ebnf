(*
   pyxc_grammar_complete.ebnf
   Complete intended grammar for pyxc — current + all planned features.

   Productions marked IMPLEMENTED are live in the compiler today (chapter 43).
   Productions marked PLANNED are designed but not yet implemented.
   Productions marked DECISION NEEDED require a design choice before implementation.

   Comparison source: Python 3.14 PEG grammar (https://docs.python.org/3/reference/grammar.html)
   Only features that make sense for a no-GC systems language are included.
   Features intentionally absent from pyxc: exceptions, GC, dynamic typing,
   metaclasses, __dict__, exec/eval, *args/**kwargs, set/dict literals,
   comprehensions (deferred to generics era).
*)

(* ========================================================================
   NOTATION
   ========================================================================
   { }   = zero or more
   [ ]   = zero or one (optional)
   |     = alternation
   (* *) = comment / annotation
*)


(* ========================================================================
   PROGRAM STRUCTURE                                          IMPLEMENTED
   ======================================================================== *)

program     = [ eols ] [ top { eols top } ] [ eols ] ;
eols        = eol { eol } ;

top         = moduledecl
            | importdecl
            | fromimport          (* PLANNED *)
            | exportdecl
            | enumdef             (* PLANNED *)
            | typealias
            | traitdef
            | structdef
            | classdef
            | impldef
            | definition
            | asyncdef            (* PLANNED *)
            | decorateddef
            | constdecl           (* PLANNED *)
            | external
            | toplevelexpr ;

toplevelexpr = expression ;


(* ========================================================================
   MODULE SYSTEM
   ======================================================================== *)

moduledecl  = "module" modulepath ;                              (* IMPLEMENTED *)
modulepath  = identifier { "." identifier } ;                   (* IMPLEMENTED *)

importdecl  = "import" modulepath [ "as" identifier ] ;         (* "as" PLANNED *)

fromimport  = "from" modulepath "import"                        (* PLANNED *)
              ( "*" | importname { "," importname } ) ;
importname  = identifier [ "as" identifier ] ;

exportdecl  = "export"                                          (* IMPLEMENTED *)
              ( definition | asyncdef | external | structdef
              | classdef | enumdef | typealias | traitdef | impldef ) ;


(* ========================================================================
   TYPE DECLARATIONS
   ======================================================================== *)

typealias   = "type" identifier "=" type ;                      (* IMPLEMENTED *)

enumdef     = "enum" identifier                                  (* PLANNED *)
              [ ":" builtininttype ]
              ":" eols indent enumbody dedent ;
enumbody    = enumvariant { eols enumvariant } ;
enumvariant = identifier [ "=" integer ] ;
              (* e.g.  enum Color: Red, Green = 5, Blue *)

traitdef    = "trait" identifier [ "[" identifier "]" ] ":"     (* IMPLEMENTED *)
              eols traitblock ;
traitblock  = indent traitmethodsig { eols traitmethodsig } dedent ;
traitmethodsig = "def" identifier
                 "(" [ typedparam { "," typedparam } ] ")"
                 [ "->" type ] ;

structdef   = "struct" identifier ":" eols structblock ;        (* IMPLEMENTED *)

classdef    = "class" identifier                                 (* IMPLEMENTED *)
              [ "[" identifier "]" ]                            (* generic param PLANNED *)
              [ "(" traitref { "," traitref } ")" ]
              ":" eols classblock ;
traitref    = identifier [ "[" type "]" ] ;

classblock  = indent classmember { eols classmember } dedent ;
classmember = [ visibility ] ( fielddecl | staticmember | methoddef ) ;
visibility  = "public" | "private" ;                            (* IMPLEMENTED *)
staticmember = "static" ( fielddecl | methoddef ) ;            (* PLANNED *)

fielddecl   = identifier ":" type ;                             (* IMPLEMENTED *)
methoddef   = "def" identifier
              "(" [ typedparam { "," typedparam } ] ")"
              [ "->" type ] ":" ( simplestmt | eols block ) ;  (* IMPLEMENTED *)
              (* self is implicit — not written in the param list *)

impldef     = "impl" traitref "for" identifier ":" eols implblock ; (* IMPLEMENTED *)
implblock   = indent implmethod { eols implmethod } dedent ;
implmethod  = "def" identifier
              "(" [ typedparam { "," typedparam } ] ")"
              [ "->" type ] ":" ( simplestmt | eols block ) ;


(* ========================================================================
   FUNCTION DEFINITIONS
   ======================================================================== *)

definition  = "def" prototype [ "->" type ] ":"                 (* IMPLEMENTED *)
              ( simplestmt | eols block ) ;

prototype   = identifier "(" [ typedparam { "," typedparam } ] ")" ;
typedparam  = identifier ":" type [ "=" expression ] ;         (* default value PLANNED *)

external    = "extern" "def" externprototype [ "->" type ] ;   (* IMPLEMENTED *)
externprototype = identifier
                  "(" [ typedparam { "," typedparam }
                        [ "," "..." ] | "..." ] ")" ;

asyncdef    = "async" "def" prototype [ "->" type ] ":"        (* PLANNED — Phase 7 *)
              ( simplestmt | eols block ) ;

decorateddef = binarydecorator eols "def" binaryopprototype    (* IMPLEMENTED *)
                  [ "->" type ] ":" ( simplestmt | eols block )
             | unarydecorator eols "def" unaryopprototype
                  [ "->" type ] ":" ( simplestmt | eols block )
             | funcdecorator eols definition ;                  (* general decorator PLANNED *)

funcdecorator     = "@" expression ;
binarydecorator   = "@" "binary" "(" integer ")" ;
unarydecorator    = "@" "unary" ;
binaryopprototype = customopchar "(" typedparam "," typedparam ")" ;
unaryopprototype  = customopchar "(" typedparam ")" ;


(* ========================================================================
   STATEMENTS
   ======================================================================== *)

simplestmt  = returnstmt
            | breakstmt
            | continuestmt
            | passstmt            (* PLANNED — trivial *)
            | assertstmt          (* PLANNED *)
            | deferstmt           (* PLANNED *)
            | yieldstmt           (* PLANNED — Phase generators *)
            | gostmt              (* PLANNED — low priority *)
            | nonlocalstmt        (* PLANNED — needed for closures *)
            | varstmt
            | conststmt           (* PLANNED *)
            | staticstmt          (* PLANNED — static local variable *)
            | assignstmt
            | expression ;

compoundstmt = ifstmt
             | forstmt
             | foreachstmt        (* PLANNED: for x in expr *)
             | whilestmt
             | dowhilestmt
             | switchstmt
             | matchstmt          (* PLANNED *)
             | withstmt ;         (* PLANNED *)

statement   = simplestmt | compoundstmt ;
suite       = simplestmt | compoundstmt | eols block ;
block       = indent statement { eols statement } dedent ;      (* IMPLEMENTED *)

returnstmt    = "return" [ expression ] ;                       (* IMPLEMENTED *)
breakstmt     = "break" ;                                       (* IMPLEMENTED *)
continuestmt  = "continue" ;                                    (* IMPLEMENTED *)
passstmt      = "pass" ;                                        (* PLANNED *)
assertstmt    = "assert" expression [ "," expression ] ;        (* PLANNED *)
deferstmt     = "defer" expression ;                            (* PLANNED *)
yieldstmt     = "yield" [ expression ]                          (* PLANNED *)
              | "yield" "from" expression ;
gostmt        = "goto" identifier ;                             (* PLANNED *)
labelstmt     = identifier ":" ;                                (* PLANNED — top of block only *)
nonlocalstmt  = "nonlocal" identifier { "," identifier } ;     (* PLANNED *)

varstmt       = "var" varbinding { "," varbinding } ;          (* IMPLEMENTED *)
varbinding    = identifier ":" type [ "=" expression ] ;        (* IMPLEMENTED *)

conststmt     = "const" identifier ":" type "=" expression ;   (* PLANNED *)
staticstmt    = "static" identifier ":" type [ "=" expression ] ; (* PLANNED — function scope *)

constdecl     = "const" identifier ":" type "=" expression ;   (* PLANNED — module scope *)

assignstmt    = lvalue assignop expression ;                    (* IMPLEMENTED *)
lvalue        = identifier | fieldaccess | indexexpr ;


(* ========================================================================
   CONTROL FLOW
   ======================================================================== *)

ifstmt      = "if" expression ":" suite                         (* IMPLEMENTED *)
              { eols "elif" expression ":" suite }
              [ eols "else" ":" suite ] ;

whilestmt   = "while" expression ":" suite ;                   (* IMPLEMENTED *)

dowhilestmt = "do" ":" suite eols "while" expression ;         (* IMPLEMENTED *)

forstmt     = "for"                                             (* IMPLEMENTED — C-style *)
              ( "var" identifier ":" type | identifier )
              "=" expression "," expression "," expression
              ":" suite ;

foreachstmt = "for"                                             (* PLANNED — iterator-style *)
              ( "var" identifier [ ":" type ] | identifier )
              "in" expression ":" suite ;
              (* requires iterator protocol / range() *)

switchstmt  = "switch" expression ":" eols indent switchbody dedent ; (* IMPLEMENTED *)
switchbody  = switchcase { eols switchcase } [ eols defaultcase ] ;
switchcase  = "case" switchint ":" suite ;
defaultcase = "default" ":" suite ;

matchstmt   = "match" expression ":" eols indent matchbody dedent ; (* PLANNED *)
matchbody   = matchcase { eols matchcase } [ eols matchdefault ] ;
matchcase   = "case" pattern [ "if" expression ] ":" suite ;
matchdefault = "case" "_" ":" suite ;

pattern     = literalpat | enumpat | structpat | wildcardpat   (* PLANNED *)
            | bindingpat | orpat ;
literalpat  = number | stringliteral | charliteral | bool_literal | "null" ;
enumpat     = identifier "." identifier ;
structpat   = identifier "(" [ fieldpat { "," fieldpat } ] ")" ;
fieldpat    = identifier "=" pattern ;
wildcardpat = "_" ;
bindingpat  = identifier ;
orpat       = pattern "|" pattern ;

withstmt    = "with" expression [ "as" identifier ] ":" suite ; (* PLANNED *)
              (* requires __enter__ / __exit__ protocol on class *)


(* ========================================================================
   EXPRESSIONS
   ======================================================================== *)

expression  = ternary | lambdaexpr | assignexpr ;

ternary     = orexpr "if" orexpr "else" expression ;           (* PLANNED *)

lambdaexpr  = "fn" "(" [ lambdaparam { "," lambdaparam } ] ")" (* PLANNED — ch44 closures *)
              [ "->" type ] ":" expression ;
lambdaparam = identifier [ ":" type ] ;

assignexpr  = unaryexpr binoprhs [ assignop expression ] ;     (* IMPLEMENTED *)
              (* assignment has expression value — right-associative *)

walrusexpr  = identifier ":=" expression ;                     (* PLANNED — if needed *)
              (* may be redundant since = already works as expression *)

awaitexpr   = "await" expression ;                             (* PLANNED — Phase 7 *)

binoprhs    = { binaryop unaryexpr } ;

assignop    = "=" | "+=" | "-=" | "*=" | "/=" | "%="          (* IMPLEMENTED *)
            | "&=" | "|=" | "^=" | "<<=" | ">>=" ;            (* &= |= ^= <<= >>= PLANNED *)

binaryop    = builtinbinaryop | userdefbinaryop ;

builtinbinaryop
            = "+" | "-" | "*" | "/" | "%"
            | "<" | "<=" | ">" | ">=" | "==" | "!="
            | "&&" | "||"                                       (* IMPLEMENTED *)
            | "and" | "or"                                     (* PLANNED — keyword aliases *)
            | "&" | "|" | "^" | "<<" | ">>"
            | "in" | "not" "in"                                (* PLANNED *)
            | "is" | "is" "not" ;                              (* PLANNED — pointer identity *)

unaryexpr   = unaryop unaryexpr | postfixexpr ;                (* IMPLEMENTED *)
unaryop     = "-" | "!" | "not" | "~" | "++" | "--"           (* "not" PLANNED *)
            | userdefunaryop ;
postfixexpr = primary [ postfixop ] ;
postfixop   = "++" | "--" ;                                    (* IMPLEMENTED *)


(* ========================================================================
   PRIMARY EXPRESSIONS
   ======================================================================== *)

primary     = castexpr
            | sizeofexpr
            | addrexpr
            | lenexpr             (* PLANNED *)
            | arrayliteral
            | sliceexpr           (* PLANNED *)
            | fstringliteral      (* PLANNED *)
            | stringliteral
            | charliteral
            | identifierexpr
            | fieldaccess
            | indexexpr
            | numberexpr
            | bool_literal
            | nullliteral         (* PLANNED *)
            | parenexpr ;

castexpr    = casttype "(" expression ")" ;                    (* IMPLEMENTED *)
sizeofexpr  = "sizeof" "(" type ")" ;                          (* IMPLEMENTED *)
addrexpr    = "addr" "(" lvalue ")" ;                          (* IMPLEMENTED *)
lenexpr     = "len" "(" expression ")" ;                       (* PLANNED — compile-time for arrays *)

identifierexpr = identifier | callexpr | methodcallexpr | ctorcallexpr ;
callexpr    = identifier "(" [ callarg { "," callarg } ] ")" ; (* named args PLANNED *)
callarg     = [ identifier "=" ] expression ;                  (* PLANNED *)
methodcallexpr = expression "." identifier                     (* IMPLEMENTED *)
                 "(" [ callarg { "," callarg } ] ")" ;         (* named args PLANNED *)
ctorcallexpr   = identifier "(" [ callarg { "," callarg } ] ")" ; (* IMPLEMENTED *)
fieldaccess    = expression "." identifier { "." identifier } ; (* IMPLEMENTED *)
indexexpr      = expression "[" expression "]" ;               (* IMPLEMENTED *)

sliceexpr   = expression "[" slicerange "]" ;                  (* PLANNED *)
slicerange  = [ expression ] ":" [ expression ] [ ":" [ expression ] ] ;

arrayliteral   = "[" [ expression { "," expression } ] "]" ;  (* IMPLEMENTED *)
stringliteral  = "\"" { strchar | escape } "\"" ;             (* IMPLEMENTED *)
charliteral    = "'" ( strchar | charescape ) "'" ;            (* IMPLEMENTED *)
fstringliteral = "f\"" { strchar | escape | "{" expression "}" } "\"" ; (* PLANNED *)
numberexpr     = number ;                                      (* IMPLEMENTED *)
bool_literal   = "True" | "False" ;                            (* IMPLEMENTED *)
nullliteral    = "null" ;                                      (* PLANNED — typed null pointer *)
parenexpr      = "(" expression ")" ;                          (* IMPLEMENTED *)

escape      = "\\" ( "\\" | "\"" | "n" | "t" | "r" | "0" ) ; (* IMPLEMENTED *)
charescape  = "\\" ( "\\" | "'" | "n" | "t" | "r" | "0" ) ;  (* IMPLEMENTED *)


(* ========================================================================
   TYPE SYSTEM
   ======================================================================== *)

type        = basetype [ arraysuffix ] ;                       (* IMPLEMENTED *)
basetype    = builtintype | funcptrtype | optionaltype
            | aliastype | structtype | pointertype | enumtype ;

builtintype = builtininttype | builtinfloattype | "bool" | "None" ;
builtininttype
            = "int" | "int8" | "int16" | "int32" | "int64"
            | "uint8" | "uint16" | "uint32" | "uint64" ;       (* IMPLEMENTED *)
builtinfloattype
            = "float" | "float32" | "float64" ;                (* IMPLEMENTED *)

pointertype = "ptr" "[" type "]" ;                             (* IMPLEMENTED *)
              (* "ptr" alone as untyped void* pointer PLANNED *)
funcptrtype = "ptr" "[" "def"                                  (* PLANNED *)
              "(" [ type { "," type } ] ")" "->" type "]" ;
              (* e.g.  ptr[def(int, int) -> bool] *)
optionaltype = type "?" ;                                      (* PLANNED *)
enumtype    = identifier ;                                     (* PLANNED — resolved via StructTypes *)
aliastype   = identifier ;                                     (* IMPLEMENTED *)
structtype  = identifier ;                                     (* IMPLEMENTED *)
arraysuffix = "[" integer "]" ;                                (* IMPLEMENTED *)
              (* nested arraysuffix e.g. int[3][4]  PLANNED *)

generictype = identifier "[" type { "," type } "]" ;           (* PLANNED *)
              (* e.g.  Stack[int], Map[int32, ptr[int8]] *)

casttype    = "int" | "int8" | "int16" | "int32" | "int64"
            | "uint8" | "uint16" | "uint32" | "uint64"
            | "float" | "float32" | "float64"
            | "bool" | pointertype ;                           (* IMPLEMENTED *)


(* ========================================================================
   IDENTIFIERS AND LITERALS
   ======================================================================== *)

identifier  = ( letter | "_" ) { letter | digit | "_" } ;
number      = digit { digit } [ "." { digit } ]
            | "." digit { digit } ;
integer     = digit { digit } ;
switchint   = [ "-" ] integer ;
letter      = "A".."Z" | "a".."z" ;
digit       = "0".."9" ;

userdefbinaryop = ? any opchar defined as a custom binary operator ? ;
userdefunaryop  = ? any opchar defined as a custom unary operator ? ;
customopchar    = ? any opchar not already reserved or defined ? ;
opchar          = ? any single ASCII punctuation character ? ;


(* ========================================================================
   LEXER TOKENS
   ======================================================================== *)

eol         = "\r\n" | "\r" | "\n" ;
ws          = " " | "\t" ;
INDENT      = ? synthetic token emitted by lexer when indentation increases ? ;
DEDENT      = ? synthetic token emitted by lexer when indentation decreases ? ;
strchar     = ? any character except the string delimiter and newline ? ;


(* ========================================================================
   PYTHON GRAMMAR COMPARISON — FEATURES NOT IN PYXC (BY DESIGN)
   ========================================================================
   The following Python constructs are deliberately absent from pyxc:

   - Exceptions (raise, try, except, finally)
       No exception handling. Error propagation via return values or Result type.

   - Garbage-collected containers (dict, set, frozenset, list with GC)
       pyxc is no-GC. Containers will come via generic stdlib (List[T] etc.)
       backed by explicit malloc/free.

   - Dynamic typing (x = 5; x = "hello")
       pyxc is statically typed. All bindings have a fixed type.

   - *args / **kwargs
       No variadic pyxc functions. Only extern def supports variadic C calls.

   - Comprehensions (list, set, dict, generator expressions)
       Deferred until generic collections and iterator protocol are in place.

   - Metaclasses, __class__, __dict__, descriptors
       No runtime type introspection.

   - exec / eval / compile
       No runtime code generation from strings.

   - Global scope mutation (global x; x = ...)
       pyxc globals are module-level vars, assignable without 'global' keyword.

   - Multiple inheritance
       Decision needed (see ROADMAP). Traits cover interface polymorphism.

   - Complex numbers, imaginary literals
       Not a target use case.

   - Ellipsis literal (...), None as a value (vs None return type)
       null literal planned instead.

   - with statement + context managers
       Replaced by defer for resource cleanup in no-GC context.

   - @= (matrix multiply augmented assign)
       Not planned.

   - // (floor division)
       Integer division already works via typed division (int / int = int).

   - ** (exponentiation)
       Available via user-defined @binary(N) operator.
   ======================================================================== *)
